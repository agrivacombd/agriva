# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# One9 SMS (server-side only; never prefix with NEXT_PUBLIC_)
ONE9_SMS_API_KEY=

# Optional Google Analytics 4 (measurement ID only; e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Meta Pixel (numeric ID; loads only after Marketing consent)
NEXT_PUBLIC_META_PIXEL_ID=

# Payment webhook (online payment can be enabled later)
PAYMENT_WEBHOOK_SECRET=

# Optional AI content generation (Gemini free-tier key can be used when available)
# Crop disease photo analysis (server-side; never expose the key to the browser)
# Requires applying supabase/migrations/017_crop_disease_detections.sql
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Optional integrations
WEATHER_API_KEY=
NEXT_PUBLIC_MAP_API_KEY=
RESEND_API_KEY=
